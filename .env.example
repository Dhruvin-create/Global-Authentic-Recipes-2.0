# ============================================
# Database Configuration (Local Development - Laragon)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=global_recipes
DATABASE_URL=mysql://root@localhost:3306/global_recipes

# ============================================
# Database Configuration (Production - PlanetScale/Railway)
# Uncomment and use these for production deployment
# ============================================
# DB_HOST=your-database-host.psdb.cloud
# DB_PORT=3306
# DB_USER=your-username
# DB_PASSWORD=your-password
# DB_NAME=global_recipes
# DATABASE_URL=mysql://username:password@host.psdb.cloud/global_recipes?ssl={"rejectUnauthorized":true}

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production URL (Update after Vercel deployment)
# NEXT_PUBLIC_API_URL=https://your-app.vercel.app

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-super-secret-session-key-change-this

# ============================================
# OAuth Configuration (Optional)
# For Google/Facebook/Instagram login
# ============================================
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-nextauth-secret-key

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
# FACEBOOK_CLIENT_ID=your-facebook-app-id
# FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Instagram OAuth
# INSTAGRAM_CLIENT_ID=your-instagram-client-id
# INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# ============================================
# File Upload
# ============================================
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ============================================
# Email Configuration (Optional - for verification emails)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@globalrecipes.com

# ============================================
# SMS Configuration (Optional - for phone verification)
# ============================================
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# Analytics (Optional)
# ============================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# ============================================
# Error Tracking (Optional)
# ============================================
# SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
